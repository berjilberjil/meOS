{
  "name": "@meos/mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Central MeOS Model Context Protocol gateway (stdio + Streamable HTTP).",
  "bin": {
    "meos-mcp": "./src/index.ts"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "start:stdio": "MEOS_MCP_TRANSPORT=stdio node --env-file-if-exists=.env src/index.ts",
    "start:http": "MEOS_MCP_TRANSPORT=http node --env-file-if-exists=.env src/index.ts",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "test:restore": "node --experimental-strip-types ../../scripts/restore-drill.ts",
    "test:rotate": "node --experimental-strip-types ../../scripts/key-rotation-drill.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "overrides": {
    "fast-uri": "^3.1.9",
    "hono": "^4.13.16",
    "ip-address": "^10.7.4",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
