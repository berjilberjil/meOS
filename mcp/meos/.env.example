# MeOS MCP gateway — copy to mcp/meos/.env and chmod 600.
# NEVER commit the filled-in file. The root .gitignore ignores .env and .env.*
# while keeping .env.example.

# ── Transport ────────────────────────────────────────────────────────────────
# stdio (default): local desktop clients launch the process.
# http: Streamable HTTP, for clients that connect over the network.
MEOS_MCP_TRANSPORT=stdio

# ── The MeOS account (server-side only) ──────────────────────────────────────
# These are the same credentials the app uses. They never leave this process and
# are never accepted as tool arguments.
MEOS_BASE_URL=https://meos-api.berjiljacob.workers.dev
MEOS_USERNAME=
MEOS_PASSWORD=

# Needed to read/write the zero-knowledge vault. Use the vault passphrase OR the
# one-time recovery code. Without either, the gateway can report module presence
# but every encrypted read/write fails closed with `vault_locked`.
MEOS_VAULT_PASSPHRASE=
# MEOS_VAULT_RECOVERY=

# IANA timezone for "today" and app-style timestamps (default: host timezone).
# Set this when the HTTP gateway runs outside the owner's timezone.
# MEOS_TIMEZONE=Asia/Kolkata

# ── Permissions for stdio / the single HTTP token ────────────────────────────
# read        list/get/search/analyse
# write       create/update/complete
# destructive delete/purge (also requires confirm: true)
# health      health, fitness, diet and body-photo data
# secret      locked notes, profile private fields, body-photo metadata
# Default is read-only. Add scopes deliberately.
# Finance ledger writes require `write`; reads need only `read`.
MEOS_MCP_SCOPES=read

# ── HTTP transport ───────────────────────────────────────────────────────────
# Bind to loopback by default. For remote access, put TLS + a trusted proxy in
# front and set MEOS_MCP_ALLOW_REMOTE=true explicitly.
MEOS_MCP_HTTP_HOST=127.0.0.1
MEOS_MCP_HTTP_PORT=8788
MEOS_MCP_HTTP_PATH=/mcp
MEOS_MCP_ALLOW_REMOTE=false

# Simple single-client mode. Required unless MEOS_MCP_CLIENTS_JSON is set.
MEOS_MCP_HTTP_TOKEN=

# Multi-client mode: one token per client, each with its own scopes and account.
# Raw tokens are hashed in memory at startup; `token_sha256` may be supplied
# instead so the plaintext token never appears in the environment.
# MEOS_MCP_CLIENTS_JSON=[{"id":"claude-desktop","token":"REPLACE_ME","scopes":["read"],"account":"owner","expires_at":"2027-01-01T00:00:00Z"},{"id":"cursor","token_sha256":"<64 hex chars>","scopes":["read","health"],"account":"owner"}]

# Optional additional accounts for genuine multi-account isolation. Each client
# references one. Omitting this uses the MEOS_* account above as "owner".
# MEOS_MCP_ACCOUNTS_JSON=[{"id":"second","username":"other","password":"REPLACE_ME","vaultPassphrase":"REPLACE_ME"}]

# ── Limits and logging ──────────────────────────────────────────────────────
MEOS_MCP_RATE_LIMIT=120
MEOS_MCP_MAX_BODY_BYTES=2097152
MEOS_MCP_REQUEST_TIMEOUT_MS=20000
MEOS_MCP_LOG_LEVEL=info
