<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>meOS</string>
	<key>CFBundleDisplayName</key>
	<string>meOS</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Siri's voice trigger for this app. Every App Shortcut phrase embeds the
	     ${applicationName} token, so the token has to be something Siri actually
	     transcribes.

	     "meOS" is not. Spoken aloud it is a homophone of "iOS" — one of the
	     strongest tokens in Apple's speech model — and Siri reliably transcribes it
	     that way, then web-searches. Sound-alike alternatives ("Me OS", "Mios") all
	     collapsed into "iOS" too, so they were removed rather than kept as noise.

	     "Catherine" is a proper name: phonetically distant from anything Apple
	     reserves, and Siri nails it. Both spellings are registered because matching
	     runs on Siri's transcribed text, and it may spell it either way.

	     Hard cap of three — iOS refuses to install the app above that
	     (MIInstallerErrorDomain 132). -->
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Catherine</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>kath rin</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Katherine</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>kath rin</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Life OS</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>life oh ess</string>
		</dict>
	</array>

	<key>NSMicrophoneUsageDescription</key>
	<string>So you can talk to Catrine instead of typing.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Your speech is transcribed on this device and never uploaded.</string>
	<!-- `fetch` is what lets iOS wake the app to read the pedometer and
	     push today's steps, so the Mac is current without anybody having
	     opened the phone first. See StepsBackgroundRefresh. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
	</array>
	<!-- Every identifier the app registers a BGTask handler for has to
	     be listed here. A handler for an unlisted id throws at launch. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.berjil.myos.steps.refresh</string>
	</array>
	<key>NSFaceIDUsageDescription</key>
	<string>meOS uses Face ID to unlock your life data.</string>
	<key>NSCameraUsageDescription</key>
	<string>meOS uses your camera to scan receipts, food labels, and portfolio screens straight into your data.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>meOS reads photos you pick and the ones you heart in Favorites so today’s body shot lands in Fitness automatically.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>meOS saves a progress photo to your library when you tap Save.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>meOS reads today’s step count from Apple Health so Fitness stays in sync without typing.</string>
	<key>NSMotionUsageDescription</key>
	<string>meOS reads today’s steps from your iPhone so the Fitness tab stays current.</string>
	<key>NSHumanReadableCopyright</key>
	<string></string>
	<!-- Dev convenience: reach the localhost backend + your future HTTPS domain.
	     Tighten this to specific domains before you ever ship meOS to anyone else. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
