<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>MyOS</string>
	<key>CFBundleDisplayName</key>
	<string>MyOS</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Siri never transcribes the spoken app name as the literal "MyOS" — it hears
	     "my OS" / "my iOS" / "mios". Every App Shortcut phrase embeds the
	     ${applicationName} token, so without these the token never matches and Siri
	     falls through to a web search. These register the spoken forms that token
	     should also accept. -->
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>My OS</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>my oh ess</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>My iOS</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>my eye oh ess</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Mios</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>mee ohs</string>
		</dict>
	</array>
	<!-- iOS rejects the install outright above three entries (MIInstallerErrorDomain
	     132), so these three are the whole budget: the two most likely mis-hearings
	     plus the run-together one. -->

	<key>NSFaceIDUsageDescription</key>
	<string>MyOS uses Face ID to unlock your life data.</string>
	<key>NSCameraUsageDescription</key>
	<string>MyOS uses your camera to scan receipts, food labels, and portfolio screens straight into your data.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>MyOS reads a photo you pick so AI can turn it into transactions, food, or holdings.</string>
	<key>NSHumanReadableCopyright</key>
	<string></string>
	<!-- Dev convenience: reach the localhost backend + your future HTTPS domain.
	     Tighten this to specific domains before you ever ship MyOS to anyone else. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
