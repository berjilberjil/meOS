# Copy to .env and fill in. NEVER commit the real .env — it is gitignored.

# Supabase Postgres connection string (Transaction pooler URL, port 6543).
DATABASE_URL=postgresql://...

# Google Gemini — used only by the AI routes (server-side; the mac app never sees it).
# GEMINI_MODEL: the everyday model for text + screenshot reading (fast/cheap is fine).
# GEMINI_REASONING_MODEL: optional stronger model for the weekly portfolio review
#   (POST /api/advise). Falls back to GEMINI_MODEL if unset.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_REASONING_MODEL=gemini-2.5-pro
