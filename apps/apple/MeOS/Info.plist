<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.berjil.meos.steps.refresh</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>MeOS</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>MeOS uses the camera to scan food, labels and things.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>MeOS uses Face ID to unlock your data.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>So you can talk to Catherine instead of typing.</string>
	<key>NSMotionUsageDescription</key>
	<string>MeOS reads today's steps from your iPhone.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>MeOS saves a progress photo when you tap Save.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>MeOS reads photos you pick and the ones you heart in Favorites for body photos.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Your speech is transcribed on this device and never uploaded.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
