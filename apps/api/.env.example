# Copy to `.dev.vars` for `bun run dev`, or set with
# `wrangler secret put <NAME>` in production. NEVER commit real values.
# The database and media bucket are bindings from wrangler.jsonc, not env vars.

# Google Gemini — used by the AI routes when the user has not added their own
# provider key. Server-side only; the app never sees it.
# GEMINI_MODEL: everyday model for text + screenshot reading (fast/cheap).
# GEMINI_REASONING_MODEL: optional stronger model for plan generation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_REASONING_MODEL=gemini-2.5-pro
# GEMINI_CHAT_API_KEY / GEMINI_CHAT_MODEL: dedicated key + model for the mentor
# chat route (POST /api/chat) only. Both fall back to GEMINI_API_KEY /
# 'gemini-flash-latest' if unset. Use a "-latest" alias — pinned versions get
# retired for new keys.
# GEMINI_CHAT_API_KEY=
# GEMINI_CHAT_MODEL=gemini-flash-latest

# Master key for encrypting user-added AI provider keys at rest (AES-256-GCM).
# Generate with:  openssl rand -base64 32
# Required for Settings → AI providers. NEVER commit the real value.
# (Legacy name MYOS_SECRETS_KEY still works as a fallback.)
MEOS_SECRETS_KEY=

# Cloudflare R2 (S3-compatible) — private media (progress photos, event media).
# The bucket itself comes from wrangler.jsonc; these are only for signing URLs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=meos-media

# Optional. Registration is closed once the first account exists; set this to
# the exact string `true` only when deliberately creating another account.
# MEOS_ALLOW_SIGNUP=true
