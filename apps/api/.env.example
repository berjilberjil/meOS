# Copy to .env and fill in. NEVER commit the real .env — it is gitignored.

# Supabase Postgres connection string (Transaction pooler URL, port 6543).
DATABASE_URL=postgresql://...

# Google Gemini — used only by the AI routes (server-side; the mac app never sees it).
# GEMINI_MODEL: the everyday model for text + screenshot reading (fast/cheap is fine).
# GEMINI_REASONING_MODEL: optional stronger model for plan generation
#   (POST /api/plan). Falls back to GEMINI_MODEL if unset.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_REASONING_MODEL=gemini-2.5-pro
# GEMINI_CHAT_API_KEY / GEMINI_CHAT_MODEL: dedicated key + free model for the mentor
#   chat route (POST /api/chat) only. Use when the main key can't serve chat. Both
#   fall back to GEMINI_API_KEY / 'gemini-flash-latest' if unset. Use a "-latest"
#   alias — pinned versions get retired for new keys.
# GEMINI_CHAT_API_KEY=
# GEMINI_CHAT_MODEL=gemini-flash-latest

# Master key for encrypting user-added AI provider keys at rest (AES-256-GCM).
# Generate with:  openssl rand -base64 32
# Required for the in-app "AI providers & models" settings. If unset, those routes
# fall back to the GEMINI_* env config above. NEVER commit the real value.
MYOS_SECRETS_KEY=

# Cloudflare R2 (S3-compatible) — private media (progress photos, etc).
# Create the bucket once via the Cloudflare dashboard or:
#   wrangler r2 bucket create myos-media
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=myos-media
