# Copy to `.dev.vars` for `bun run dev`, or set with
# `wrangler secret put <NAME>` in production. NEVER commit real values.
# The database and media bucket are bindings from wrangler.jsonc, not env vars.

# Google Gemini — used by the AI routes when the user has not added their own
# provider key. Server-side only; the app never sees it.
# GEMINI_MODEL: everyday model for text + screenshot reading (fast/cheap).
# GEMINI_REASONING_MODEL: optional stronger model for plan generation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_REASONING_MODEL=gemini-2.5-pro
# GEMINI_CHAT_API_KEY / GEMINI_CHAT_MODEL: dedicated key + model for the mentor
# chat route (POST /api/chat) only. Both fall back to GEMINI_API_KEY /
# 'gemini-flash-latest' if unset. Use a "-latest" alias — pinned versions get
# retired for new keys.
# GEMINI_CHAT_API_KEY=
# GEMINI_CHAT_MODEL=gemini-flash-latest

# Master key for encrypting user-added AI provider keys and TOTP secrets at
# rest (AES-256-GCM). Generate with:  openssl rand -base64 32
# Required for Settings → AI providers and two-factor setup.
# (Legacy name MYOS_SECRETS_KEY still works as a fallback.)
MEOS_SECRETS_KEY=

# Key rotation: add a new key here, point MEOS_SECRETS_KEY_ID at it, deploy,
# then POST /api/security/rotate-ai-keys after a fresh re-auth. Keep the old key
# in the ring until that call succeeds.
# MEOS_SECRETS_KEYS={"v1":"<base64 32 bytes>","v2":"<base64 32 bytes>"}
# MEOS_SECRETS_KEY_ID=v2
# MEOS_ALLOW_WEAK_SECRETS_KEY=true   # only for a legacy passphrase; never in prod

# Login-password hashing. A dedicated pepper makes a DB-only leak unable to
# verify guesses. It is deliberately separate from MEOS_SECRETS_KEY: rotating
# the secrets key must not lock every login out. Keep this value stable; changing
# it invalidates existing v3 hashes (users would need a password reset).
# MEOS_PASSWORD_PEPPER=<openssl rand -base64 32>
# Raise iterations on a paid Workers plan (free tier CPU cap is 10ms/request).
# MEOS_PBKDF2_ITERATIONS=10000
# Separate stable pepper for MFA recovery-code hashes. Falls back to a fixed
# constant; never to the rotating secrets key or the password pepper.
# MEOS_MFA_RECOVERY_PEPPER=<openssl rand -base64 32>

# Salt for the pseudonymous IP hashes in security_events. If unset, the secrets
# key is used. Rotating it makes old hashes non-comparable, not readable.
# MEOS_AUDIT_SALT=<openssl rand -base64 32>

# CORS is denied by default. List exact origins only if a browser client needs
# the API. Native apps send no Origin and do not need this.
# MEOS_CORS_ORIGINS=https://app.example
# Extra origins allowed to make cookie-authenticated unsafe requests.
# MEOS_TRUSTED_ORIGINS=https://app.example

# Cloudflare R2 (S3-compatible) — private media (progress photos, event media).
# The bucket itself comes from wrangler.jsonc; these are only for signing URLs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=meos-media

# Optional. Registration is closed once the first account exists; set this to
# the exact string `true` only when deliberately creating another account.
# MEOS_ALLOW_SIGNUP=true

# Optional first-run gate. Generate a random token, set it before deploying, and
# send it as `setupToken` with the first registration. This closes the window
# where anyone who finds a fresh deployment can create the owner account.
# MEOS_SETUP_TOKEN=<openssl rand -base64 24>
