{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meos-api",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": { "directory": ".svelte-kit/cloudflare", "binding": "ASSETS" },
  // >= 2026-08-04 turns on nodejs_compat by default, which node:crypto
  // (scrypt for logins) and node:async_hooks (the per-request D1 context) need.
  "compatibility_date": "2026-08-20",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meos",
      "database_id": "9774f0f2-3d95-4a7b-8f73-24cc41c194bc"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "meos-media"
    }
  ],
  // Deepgram Aura synthesises Catrine's voice. Free within the 10,000
  // neuron/day allowance; src/lib/server/voiceBudget.ts caps it below that.
  "ai": { "binding": "AI" }
}
